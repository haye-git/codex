<script type="text/javascript">
$(document).ready(function(){
	$('.monster').each(function() {
		App.initializeTooltip($(this), false);
	});
	$('#select_period').on('click', function() {
		var period = $('#week :selected').val();
		App.populateRanking('boss', '<%= server_selected %>', period);
	});
});

var scrollDuration = 300;
var monsters = document.getElementById('monsters');
if (typeof(monsters) != 'undefined' && monsters != null){
	var leftPaddle = document.getElementById('left-paddle');
	var rightPaddle = document.getElementById('right-paddle');
	var itemsLength = document.getElementsByClassName('mitem').length;

	var itemSize = 100;
	var paddleMargin = 20;
	var getMonstersWrapperSize = function() {
		return document.getElementsByClassName('monster-wrapper')[0].clientWidth;
	}

	var monstersWrapperSize = getMonstersWrapperSize();
	var monstersVisibleSize = monstersWrapperSize;

	var getMonstersSize = function() {
		return itemsLength * itemSize;
	};
	var monstersSize = monsters.scrollWidth;
	var monstersInvisibleSize = monstersSize - monstersWrapperSize;

	var getMonstersPosition = function() {
		return document.getElementById('monsters').scrollLeft;
	};

	var monstersPosition = getMonstersPosition();
	var monstersEndOffset = monstersInvisibleSize - paddleMargin;

	if (monstersPosition < monstersEndOffset) {
		if (monstersPosition <= paddleMargin) {
			leftPaddle.classList.add('d-none');
		} else {
			leftPaddle.classList.remove('d-none');
		}
		rightPaddle.classList.remove('d-none');
		} else if (monstersPosition >= monstersEndOffset) {
			if (monstersPosition <= paddleMargin) {
			leftPaddle.classList.add('d-none');
		}
			rightPaddle.classList.add('d-none');
	}

	document.getElementById('monsters').addEventListener('scroll', function() {
		monstersInvisibleSize = monstersSize - monstersWrapperSize;
		var monstersPosition = getMonstersPosition();

		var monstersEndOffset = monstersInvisibleSize - paddleMargin;

		if (monstersPosition <= paddleMargin) {
			leftPaddle.classList.add('d-none');
			rightPaddle.classList.remove('d-none');
		} else if (monstersPosition < monstersEndOffset) {
			leftPaddle.classList.remove('d-none');
			rightPaddle.classList.remove('d-none');
		} else if (monstersPosition >= monstersEndOffset) {
			leftPaddle.classList.remove('d-none');
			rightPaddle.classList.add('d-none');
		}
	});

	rightPaddle.addEventListener('click', function() {
	  let sl = document.getElementById('monsters').scrollLeft,
		  cw = document.getElementById('monsters').scrollWidth;
		
	  if ((sl + 220) >= cw) {
		document.getElementById('monsters').scrollTo(cw, 0);
	  } else {
		document.getElementById('monsters').scrollTo((sl + 220), 0);
	  }
	});

	leftPaddle.addEventListener('click', function() {
	  let sl = document.getElementById('monsters').scrollLeft;
		
	  if ((sl - 220) <= 0) {
		document.getElementById('monsters').scrollTo(0, 0);
	  } else {
		document.getElementById('monsters').scrollTo((sl - 220), 0);
	  }
	});
}
</script>
